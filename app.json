      "predictiveBackGestureEnabled": false,
      "versionCode": 1,
      "package": "com.miaoda.appcphr4ki6a3up"
    },
    "web": {
      "bundler": "metro",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-asset",
      "expo-sqlite",
      "expo-font",
      "expo-system-ui",
      "expo-web-browser",
      [
        "expo-notifications",
        {
          "icon": "./assets/icon.png",
          "color": "#00E5FF",
          "sounds": [],
          "mode": "production"
        }
